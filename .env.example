# Telegram application credentials (from https://my.telegram.org)
API_ID=
API_HASH=
# Create with BotFather. Never place this value in a website, app bundle, or chat.
BOT_TOKEN=
# Private Telegram channel ID. Add this bot as an administrator of that channel.
BIN_CHANNEL=
# Telegram numeric user ID permitted to use /users and /broadcast.
OWNER_ID=

# This must be a dedicated subdomain, served over HTTPS by Nginx.
PUBLIC_BASE_URL=https://telegram.movieworldug.filmjust.com
# Per-file playback keys are generated automatically and stored only as hashes in MySQL.
# There is intentionally no global stream token.
HEALTHCHECK_TOKEN=

# Dedicated least-privilege MySQL account, not the MovieWorld application account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=movieworld_telegram
DB_USERNAME=movieworld_telegram
DB_PASSWORD=

# Keep the Python process unreachable directly from the Internet.
WEB_SERVER_BIND_ADDRESS=127.0.0.1
PORT=9080
# Optional. Enable only for a private testing bot.
REQUIRE_LOGIN_PASSWORD=false
MY_PASS=
